# SQLite database file (relative to the project root)
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session cookies and derive rotating ticket QR codes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-to-a-long-random-string"

# Base URL of the app (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"

# Stripe TEST MODE keys (optional). Leave blank to use the built-in mock payment flow.
# Only sk_test_ keys are accepted; live keys are refused.
STRIPE_SECRET_KEY=""
